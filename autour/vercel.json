{
  "buildCommand": "node outils/alleger.mjs",
  "outputDirectory": "livraison",
  "headers": [
    {
      "source": "/control/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/autour.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/zones/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/:chemin((?!api/|zones/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/mentions-legales", "destination": "/mentions-legales.html" },
    { "source": "/confidentialite", "destination": "/confidentialite.html" },
    { "source": "/control", "destination": "/control.html" },
    { "source": "/control/acquisition", "destination": "/control.html" },
    { "source": "/control/validation", "destination": "/control.html" },
    { "source": "/control/journal", "destination": "/control.html" },
    { "source": "/control/territoires", "destination": "/control.html" },
    { "source": "/control/assistant", "destination": "/control.html" },
    { "source": "/control/taches", "destination": "/control.html" },
    { "source": "/control/operateur", "destination": "/control.html" },
    { "source": "/l/:id", "destination": "/index.html" },
    { "source": "/l/:id/:titre", "destination": "/index.html" },
    { "source": "/e/:id", "destination": "/index.html" },
    { "source": "/e/:id/:titre", "destination": "/index.html" },
    { "source": "/event/:id", "destination": "/index.html" },
    { "source": "/event/:id/:titre", "destination": "/index.html" },
    { "source": "/place/:id", "destination": "/index.html" },
    { "source": "/place/:id/:titre", "destination": "/index.html" },
    { "source": "/explorer", "destination": "/index.html" },
    { "source": "/solidarite", "destination": "/index.html" }
  ]
}
