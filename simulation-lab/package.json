{
  "name": "simulation-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Banc d'essai d'une simulation sociale et générationnelle. Sans écran : on prouve les systèmes avant de dessiner le premier pixel.",
  "scripts": {
    "jeu": "node outils/servir.mjs",
    "jeu:construire": "node outils/construire-jeu.mjs",
    "labo": "tsx labo/cli.ts",
    "vue": "tsx vue/construire.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p jeu",
    "verifier": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
